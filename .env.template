# LiteLLM Model Identifier
# Format: <provider>/<model-name>
# Examples: "gemini/gemini-flash-latest", "openai/gpt-4o", "anthropic/claude-3-5-sonnet"
MODEL_ID=gemini/gemini-flash-latest

# API Keys (set the one matching your MODEL_ID prefix)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_project
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# LangSmith AI Observability & Tracing (Day 16)
# Set to "true" to enable hierarchical run-tree tracing in LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-service-platform
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
